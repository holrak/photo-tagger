#: src/photo_tagger/gui.py:952
#, python-brace-format
msgid "Wrote {kept} keyword(s) to {file}, dropped {dropped}."
msgstr "{kept} palavra(s)-chave gravada(s) em {file}, {dropped} descartada(s)."

#: src/photo_tagger/gui.py:966
#, python-brace-format
msgid "Reading {file}..."
