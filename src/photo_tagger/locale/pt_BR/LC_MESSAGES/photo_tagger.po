#: src/photo_tagger/gui.py:1251
msgid "Export CSV Report..."
msgstr "Exportar Relatório CSV..."

#: src/photo_tagger/gui.py:1254
msgid ""
"Save a CSV report of every photo: generated and existing metadata, EXIF, and"
" token usage."
msgstr ""
"Salva um relatório CSV de todas as fotos: metadados gerados e existentes, "
"EXIF e uso de tokens."

#: src/photo_tagger/gui.py:1259
msgid "Clear List"
msgstr "Limpar Lista"

#: src/photo_tagger/gui.py:1261
msgid "Quit"
msgstr "Sair"

#: src/photo_tagger/gui.py:1268
msgid "Help"
msgstr "Ajuda"

#: src/photo_tagger/gui.py:1270
msgid "Documentation"
msgstr "Documentação"

#: src/photo_tagger/gui.py:1274 src/photo_tagger/gui.py:1678
msgid "Test Connection"
msgstr "Testar Conexão"

#: src/photo_tagger/gui.py:1275
msgid "Open Logs"
msgstr "Abrir Logs"

#: src/photo_tagger/gui.py:1277 src/photo_tagger/gui.py:1595
msgid "About Photo Tagger"
msgstr "Sobre o Photo Tagger"

#: src/photo_tagger/gui.py:1282
msgid "Settings"
msgstr "Configurações"

#: src/photo_tagger/gui.py:1284
msgid "Cache AI Results"
msgstr "Armazenar Resultados de IA em Cache"

#: src/photo_tagger/gui.py:1289
#, python-brace-format
msgid ""
"Reuse earlier results for unchanged photos ({cache_file}). Uncheck to call "
"the model again for everything; a single photo can skip the cache from its "
"right-click menu."
msgstr ""
"Reutiliza resultados anteriores para fotos inalteradas ({cache_file}). "
"Desmarque para chamar o modelo novamente para tudo; uma única foto pode "
"ignorar o cache pelo menu de clique direito."

#: src/photo_tagger/gui.py:1296
msgid "Send Anonymous Telemetry"
msgstr "Enviar Telemetria Anônima"

#: src/photo_tagger/gui.py:1301
msgid ""
"Anonymous usage stats (model, batch size, OS, CPU/GPU model, RAM, timing) "
"and crash reports (error type and code location only). No photos, error "
"messages, or personal data."
msgstr ""
"Estatísticas de uso anônimas (modelo, tamanho do lote, SO, modelo de "
"CPU/GPU, RAM, tempos) e relatórios de falha (apenas tipo de erro e local no "
"código). Nenhuma foto, mensagem de erro ou dado pessoal."

#: src/photo_tagger/gui.py:1308
msgid "Record Saves for Undo"
msgstr "Registrar Gravações para Desfazer"

#: src/photo_tagger/gui.py:1313
msgid ""
"Record every file a save writes, so Tools > Undo Writes can put it back. On "
"by default: the saves worth undoing are the ones nobody planned to."
msgstr ""
"Registra cada arquivo que uma gravação escreve, para que Ferramentas > "
"Desfazer Gravações possa restaurá-lo. Ativado por padrão: as gravações que "
"vale a pena desfazer são as que ninguém planejou."

#: src/photo_tagger/gui.py:1320
msgid "Keyword Rules..."
msgstr "Regras de Palavras-chave..."

#: src/photo_tagger/gui.py:1325
msgid ""
"The controlled vocabulary generated keywords are snapped onto, and whether "
"the keywords of one shoot are made to agree with each other."
msgstr ""
"O vocabulário controlado ao qual as palavras-chave geradas são ajustadas, e "
"se as palavras-chave de uma mesma sessão são harmonizadas entre si."

#: src/photo_tagger/gui.py:1334
msgid "Save Settings as Defaults..."
msgstr "Salvar Configurações como Padrão..."

#: src/photo_tagger/gui.py:1339
msgid ""
"Update the config file with the current provider, model, URL, file types, "
"and save options. Other settings and comments in the file are preserved; the"
" API key is never written."
msgstr ""
"Atualiza o arquivo de configuração com o provedor, modelo, URL, tipos de "
"arquivo e opções de gravação atuais. As demais configurações e comentários "
"do arquivo são preservados; a chave de API nunca é gravada."

#: src/photo_tagger/gui.py:1344
msgid "Edit Config File..."
msgstr "Editar Arquivo de Configuração..."

#: src/photo_tagger/gui.py:1347
msgid ""
"Open the config file in your default editor for the settings the GUI does "
"not surface (prompt file, sampling, workers, filters, ...). Created if "
"missing."
msgstr ""
"Abre o arquivo de configuração no seu editor padrão para as opções que a "
"interface não expõe (arquivo de prompt, amostragem, workers, filtros, ...). "
"Criado se não existir."

#: src/photo_tagger/gui.py:1354
msgid "Tools"
msgstr "Ferramentas"

#: src/photo_tagger/gui.py:1357
msgid "Build Vocabulary..."
msgstr "Construir Vocabulário..."

#: src/photo_tagger/gui.py:1360
msgid ""
"Write a keyword file out of the keywords your photos already carry, which is"
" what the strict vocabulary needs to enforce."
msgstr ""
"Gera um arquivo de palavras-chave a partir das que suas fotos já têm, que é "
"o que o vocabulário estrito precisa para ser aplicado."

#: src/photo_tagger/gui.py:1364
msgid "Harmonize Shoots Now"
msgstr "Harmonizar Sessões Agora"

#: src/photo_tagger/gui.py:1367
msgid ""
"Make the keywords of each shoot agree with each other: the spelling and the "
"hierarchy most of the shoot used win for all of it. Runs automatically after"
" every generation once a session gap is set (Settings > Keyword Rules)."
msgstr ""
"Faz as palavras-chave de cada sessão concordarem entre si: a grafia e a "
"hierarquia usadas na maior parte da sessão valem para toda ela. Roda "
"automaticamente depois de cada geração quando há um intervalo de sessão "
"definido (Configurações > Regras de Palavras-chave)."

#: src/photo_tagger/gui.py:1373 src/photo_tagger/gui.py:4556
msgid "Watch Folder..."
msgstr "Monitorar Pasta..."

#: src/photo_tagger/gui.py:1376
msgid ""
"Tag photos as they arrive: point it at the folder your card reader or sync "
"client fills, and each new photo joins the list and is generated for review."
msgstr ""
"Etiqueta as fotos conforme elas chegam: aponte para a pasta que seu leitor "
"de cartão ou cliente de sincronização preenche, e cada foto nova entra na "
"lista e é gerada para revisão."

#: src/photo_tagger/gui.py:1381
msgid "Undo Writes..."
msgstr "Desfazer Gravações..."

#: src/photo_tagger/gui.py:1384
msgid ""
"Put back what a recorded run wrote: sidecars it created are deleted, files "
"it overwrote are restored from the ExifTool backup. Covers CLI runs too."
msgstr ""
"Restaura o que uma execução registrada gravou: os sidecars que ela criou são"
" apagados e os arquivos que ela sobrescreveu são restaurados do backup do "
"ExifTool. Vale também para execuções na linha de comando."

#: src/photo_tagger/gui.py:1391
msgid "Language"
msgstr "Idioma"

#: src/photo_tagger/gui.py:1394
msgid ""
"Language of the app itself (menus, buttons, messages). The language of the "
"generated metadata is set under Metadata Language."
msgstr ""
"Idioma do próprio aplicativo (menus, botões, mensagens). O idioma dos "
"metadados gerados é definido em Idioma dos Metadados."

#: src/photo_tagger/gui.py:1399
msgid "System Default"
msgstr "Padrão do Sistema"

#: src/photo_tagger/gui.py:1423
msgid "Language saved. Restart Photo Tagger to apply it."
msgstr "Idioma salvo. Reinicie o Photo Tagger para aplicá-lo."

#: src/photo_tagger/gui.py:1427 src/photo_tagger/gui.py:1485
msgid "Metadata Language"
msgstr "Idioma dos Metadados"

#: src/photo_tagger/gui.py:1431
msgid ""
"Language of the generated titles, descriptions, and keywords. The language "
"of the app itself is set under Language."
msgstr ""
"Idioma dos títulos, descrições e palavras-chave gerados. O idioma do próprio"
" aplicativo é definido em Idioma."

#: src/photo_tagger/gui.py:1440
msgid "Other..."
msgstr "Outro..."

#: src/photo_tagger/gui.py:1443
msgid ""
"Any language name the model understands works; it is sent to the model as "
"is. Saved to the config file, which the CLI's --output-language default also"
" reads."
msgstr ""
"Qualquer nome de idioma que o modelo entenda funciona; ele é enviado ao "
"modelo como está. Salvo no arquivo de configuração, de onde a CLI também lê "
"o padrão de --output-language."

#: src/photo_tagger/gui.py:1486
msgid "Language for the generated titles, descriptions, and keywords:"
msgstr "Idioma dos títulos, descrições e palavras-chave gerados:"

#: src/photo_tagger/gui.py:1518
#, python-brace-format
msgid "Metadata language set to {language} for the next generation."
msgstr "Idioma dos metadados definido como {language} para a próxima geração."

#: src/photo_tagger/gui.py:1528
msgid "Anonymous telemetry on."
msgstr "Telemetria anônima ativada."

#: src/photo_tagger/gui.py:1528
msgid "Anonymous telemetry off."
msgstr "Telemetria anônima desativada."

#: src/photo_tagger/gui.py:1572
#, python-brace-format
msgid "Updated {target} (other settings and comments preserved)."
msgstr "{target} atualizado (demais configurações e comentários preservados)."

#: src/photo_tagger/gui.py:1575
#, python-brace-format
msgid "Saved defaults to {target}."
msgstr "Padrões salvos em {target}."

#: src/photo_tagger/gui.py:1597
msgid "Describe photos and add keywords with a vision-language model."
msgstr "Descreva fotos e adicione palavras-chave com um modelo de visão e linguagem."

#: src/photo_tagger/gui.py:1613
msgid "Backend that serves the vision-language model."
msgstr "Backend que serve o modelo de visão e linguagem."

#: src/photo_tagger/gui.py:1621
msgid "Model identifier. Type it, or press Refresh to list what the provider serves."
msgstr ""
"Identificador do modelo. Digite-o ou pressione Atualizar para listar o que o"
" provedor serve."

#: src/photo_tagger/gui.py:1624
msgid "Refresh"
msgstr "Atualizar"

#: src/photo_tagger/gui.py:1625
msgid "Query the provider for the models it currently serves."
msgstr "Consulta ao provedor os modelos servidos no momento."

#: src/photo_tagger/gui.py:1629
msgid "Connection..."
msgstr "Conexão..."

#: src/photo_tagger/gui.py:1630
msgid "Server URL, API key, and a connection test."
msgstr "URL do servidor, chave de API e um teste de conexão."

#: src/photo_tagger/gui.py:1634
msgid "Provider"
msgstr "Provedor"

#: src/photo_tagger/gui.py:1636
msgid "Model"
msgstr "Modelo"

#: src/photo_tagger/gui.py:1646
msgid "Connection settings"
msgstr "Configurações de conexão"

#: src/photo_tagger/gui.py:1654
msgid "(provider default URL)"
msgstr "(URL padrão do provedor)"

#: src/photo_tagger/gui.py:1656
msgid "Provider API base URL. Leave blank to use the provider's default."
msgstr "URL base da API do provedor. Deixe em branco para usar o padrão do provedor."

#: src/photo_tagger/gui.py:1658
msgid "Base URL"
msgstr "URL base"

#: src/photo_tagger/gui.py:1667
msgid "(uses provider env var)"
msgstr "(usa a variável de ambiente do provedor)"

#: src/photo_tagger/gui.py:1670
msgid ""
"API key for the provider. Leave blank to use the provider's environment "
"variable (OPENAI_API_KEY, LM_STUDIO_API_KEY, LLAMA_CPP_API_KEY, or "
"OLLAMA_API_KEY). Required for OpenAI. A typed key is used for this session "
"only and is never written to disk."
msgstr ""
"Chave de API do provedor. Deixe em branco para usar a variável de ambiente "
"do provedor (OPENAI_API_KEY, LM_STUDIO_API_KEY, LLAMA_CPP_API_KEY ou "
"OLLAMA_API_KEY). Obrigatória para a OpenAI. Uma chave digitada vale só para "
"esta sessão e nunca é gravada em disco."

#: src/photo_tagger/gui.py:1676
msgid "API key"
msgstr "Chave de API"

#: src/photo_tagger/gui.py:1680
msgid "Check ExifTool and that the provider serves the model."
msgstr "Verifica o ExifTool e se o provedor serve o modelo."

#: src/photo_tagger/gui.py:1683 src/photo_tagger/gui.py:3669
#: src/photo_tagger/gui.py:3919 src/photo_tagger/gui.py:4242
msgid "Close"
msgstr "Fechar"

#: src/photo_tagger/gui.py:1699
msgid "Photos"
msgstr "Fotos"

#: src/photo_tagger/gui.py:1699 src/photo_tagger/gui.py:2187
msgid "Type"
msgstr "Tipo"

#: src/photo_tagger/gui.py:1699 src/photo_tagger/gui.py:2188
msgid "Status"
msgstr "Status"

#: src/photo_tagger/gui.py:1699 src/photo_tagger/gui.py:2189
msgid "Tagged"
msgstr "Etiquetada"

#: src/photo_tagger/gui.py:1718
#, python-brace-format
msgid ""
"Click a column header to sort. Type: file extension, +xmp when a sidecar "
"exists.\n"
"Tagged: metadata already on the file ({legend})."
msgstr ""
"Clique no cabeçalho de uma coluna para ordenar. Tipo: extensão do arquivo, "
"+xmp quando existe um sidecar.\n"
"Etiquetada: metadados já presentes no arquivo ({legend})."

#: src/photo_tagger/gui.py:1733
msgid "Drag photos or folders here. Select one and press Delete to remove it."
msgstr ""
"Arraste fotos ou pastas para cá. Selecione uma e pressione Delete para "
"removê-la."

#: src/photo_tagger/gui.py:1750
msgid ""
"Add photos (click), or open the arrow for adding a whole folder and for the "
"folder-scan options. Dragging files or folders onto the window also works."
msgstr ""
"Adicione fotos (clique) ou abra a seta para adicionar uma pasta inteira e "
"para as opções de varredura de pastas. Arrastar arquivos ou pastas para a "
"janela também funciona."

#: src/photo_tagger/gui.py:1760
msgid "Select"
msgstr "Selecionar"

#: src/photo_tagger/gui.py:1762
msgid "Check or uncheck photos in bulk."
msgstr "Marque ou desmarque fotos em lote."

#: src/photo_tagger/gui.py:1766
msgid "Remove"
msgstr "Remover"

#: src/photo_tagger/gui.py:1768
msgid "Remove the selected folder or photo from the list (or press Delete)."
msgstr "Remove a pasta ou foto selecionada da lista (ou pressione Delete)."

#: src/photo_tagger/gui.py:1785
msgid ""
"Extensions to scan for in folders (comma-separated).\n"
"Case-insensitive: jpg matches .JPG. Note jpeg is separate from jpg."
msgstr ""
"Extensões a procurar nas pastas (separadas por vírgula).\n"
"Sem distinção de maiúsculas: jpg encontra .JPG. Note que jpeg é separado de "
"jpg."

#: src/photo_tagger/gui.py:1789
msgid "File types"
msgstr "Tipos de arquivo"

#: src/photo_tagger/gui.py:1790 src/photo_tagger/gui.py:4406
msgid "Include subfolders"
msgstr "Incluir subpastas"

#: src/photo_tagger/gui.py:1792
msgid "Descend into subfolders when adding a folder."
msgstr "Desce às subpastas ao adicionar uma pasta."

#: src/photo_tagger/gui.py:1802
msgid "Check All"
msgstr "Marcar Todas"

#: src/photo_tagger/gui.py:1803
msgid "Uncheck All"
msgstr "Desmarcar Todas"

#: src/photo_tagger/gui.py:1804
msgid "Invert Checked"
msgstr "Inverter Marcação"

#: src/photo_tagger/gui.py:1807
msgid "Uncheck Already Tagged"
msgstr "Desmarcar Já Etiquetadas"

#: src/photo_tagger/gui.py:1810
msgid ""
"Uncheck photos that already have the chosen metadata (in the image or its "
"XMP sidecar), e.g. 'a title and a description' to skip those while keeping "
"keyword-only photos. Mirrors the CLI's --skip-tagged."
msgstr ""
"Desmarca fotos que já têm os metadados escolhidos (na imagem ou no sidecar "
"XMP), p. ex. 'título e descrição' para pular essas mantendo as fotos só com "
"palavras-chave. Espelha o --skip-tagged da CLI."

#: src/photo_tagger/gui.py:1827
msgid "Uncheck From Skip List..."
msgstr "Desmarcar por Lista de Exclusão..."

#: src/photo_tagger/gui.py:1830
msgid ""
"Uncheck photos whose filename or full path is listed in a text file (one per"
" line), like the CLI's --skip-from."
msgstr ""
"Desmarca fotos cujo nome ou caminho completo esteja listado em um arquivo de"
" texto (um por linha), como o --skip-from da CLI."

#: src/photo_tagger/gui.py:1839 src/photo_tagger/gui.py:1849
msgid "Add photos before selecting."
msgstr "Adicione fotos antes de selecionar."

#: src/photo_tagger/gui.py:1880
msgid "Retry Generation"
msgstr "Tentar Gerar Novamente"

#: src/photo_tagger/gui.py:1880
msgid "Generate"
msgstr "Gerar"

#: src/photo_tagger/gui.py:1884
msgid "Generate (Skip Cache)"
msgstr "Gerar (Ignorar Cache)"

#: src/photo_tagger/gui.py:1888
msgid "Call the model even when a cached result exists for this photo."
msgstr "Chama o modelo mesmo quando existe um resultado em cache para esta foto."

#: src/photo_tagger/gui.py:1894 src/photo_tagger/gui.py:1948
msgid "Remove From List"
msgstr "Remover da Lista"

#: src/photo_tagger/gui.py:1916
#, python-brace-format
msgid "Check {n} Photo"
msgid_plural "Check {n} Photos"
msgstr[0] "Marcar {n} Foto"
msgstr[1] "Marcar {n} Fotos"

#: src/photo_tagger/gui.py:1920
#, python-brace-format
msgid "Uncheck {n} Photo"
msgid_plural "Uncheck {n} Photos"
msgstr[0] "Desmarcar {n} Foto"
msgstr[1] "Desmarcar {n} Fotos"

#: src/photo_tagger/gui.py:1924
#, python-brace-format
msgid "Check Only {n} Photo"
msgid_plural "Check Only {n} Photos"
msgstr[0] "Marcar Apenas {n} Foto"
msgstr[1] "Marcar Apenas {n} Fotos"

#: src/photo_tagger/gui.py:1928
msgid "Check the selected photos and uncheck every other photo in the list."
msgstr "Marca as fotos selecionadas e desmarca todas as outras da lista."

#: src/photo_tagger/gui.py:1932
#, python-brace-format
msgid "Generate {n} Photo"
msgid_plural "Generate {n} Photos"
msgstr[0] "Gerar {n} Foto"
msgstr[1] "Gerar {n} Fotos"

#: src/photo_tagger/gui.py:1938
#, python-brace-format
msgid "Generate {n} Photo (Skip Cache)"
msgid_plural "Generate {n} Photos (Skip Cache)"
msgstr[0] "Gerar {n} Foto (Ignorar Cache)"
msgstr[1] "Gerar {n} Fotos (Ignorar Cache)"

#: src/photo_tagger/gui.py:1944 src/photo_tagger/gui.py:2596
msgid "One-time: call the model even for photos with cached results."
msgstr "Uma única vez: chama o modelo mesmo para fotos com resultados em cache."

#: src/photo_tagger/gui.py:2166
msgid "Show"
msgstr "Mostrar"

#: src/photo_tagger/gui.py:2169
msgid "All"
msgstr "Todas"

#: src/photo_tagger/gui.py:2170
msgid "Selected"
msgstr "Selecionadas"

