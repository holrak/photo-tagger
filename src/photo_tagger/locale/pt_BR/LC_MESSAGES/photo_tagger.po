msgid_plural "Deselected {n} photos with {phrase}; {selected} still selected."
msgstr[0] "Desmarcada {n} foto com {phrase}; {selected} ainda selecionadas."
msgstr[1] "Desmarcadas {n} fotos com {phrase}; {selected} ainda selecionadas."

#: src/photo_tagger/gui.py:2752
#, python-brace-format
