#: src/photo_tagger/gui.py:1049
#, python-brace-format
msgid "Organizing {n} keyword(s) with {model}..."
msgstr "Organizando {n} palavra(s)-chave com {model}..."

#: src/photo_tagger/gui.py:1225
msgid "Zoom out"
msgstr "Reduzir"

#: src/photo_tagger/gui.py:1232
msgid "Zoom in"
msgstr "Ampliar"

#: src/photo_tagger/gui.py:1235
msgid "Fit"
msgstr "Ajustar"

#: src/photo_tagger/gui.py:1236
