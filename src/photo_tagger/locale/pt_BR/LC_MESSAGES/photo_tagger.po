msgid "Not generated"
msgstr "Não geradas"

#: src/photo_tagger/gui.py:2172
msgid "Generated"
msgstr "Geradas"

#: src/photo_tagger/gui.py:2173
msgid "Saved"
msgstr "Salvas"

#: src/photo_tagger/gui.py:2174
msgid "Failed"
msgstr "Com falha"

#: src/photo_tagger/gui.py:2175
msgid "Untagged"
msgstr "Sem etiquetas"

#: src/photo_tagger/gui.py:2178
msgid "Show only the photos in the chosen state."
msgstr "Mostra apenas as fotos no estado escolhido."

#: src/photo_tagger/gui.py:2183
msgid "Sort by"
msgstr "Ordenar por"

#: src/photo_tagger/gui.py:2186
