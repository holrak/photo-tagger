msgstr "Gravar o relatório de descartes em"

#: src/photo_tagger/gui.py:4093
msgid "CSV files (*.csv);;All files (*)"
msgstr "Arquivos CSV (*.csv);;Todos os arquivos (*)"

#: src/photo_tagger/gui.py:4106
msgid "Pick a source: the photos in the list, a keyword export, or both."
msgstr ""
"Escolha uma fonte: as fotos da lista, uma exportação de palavras-chave, ou "
"ambas."

#: src/photo_tagger/gui.py:4142
msgid "Working..."
msgstr "Processando..."

#: src/photo_tagger/gui.py:4156
msgid "Use this vocabulary?"
msgstr "Usar este vocabulário?"

#: src/photo_tagger/gui.py:4157
msgid "Snap the keywords of the next generation onto the file you just built?"
msgstr ""
"Ajustar as palavras-chave da próxima geração ao arquivo que você acabou de "
"construir?"

#: src/photo_tagger/gui.py:4204
msgid "Undo writes"
msgstr "Desfazer gravações"

#: src/photo_tagger/gui.py:4209
msgid ""
"Every recorded run, newest first, from this window and from the command "
"line. Undoing deletes the sidecars a run created and restores the files it "
"overwrote from their ExifTool backup."
msgstr ""
"Todas as execuções registradas, da mais recente à mais antiga, desta janela "
"e da linha de comando. Desfazer apaga os sidecars que a execução criou e "
"restaura os arquivos que ela sobrescreveu a partir do backup do ExifTool."

#: src/photo_tagger/gui.py:4221
msgid "Also revert files changed since the run"
msgstr "Reverter também os arquivos alterados desde a execução"

#: src/photo_tagger/gui.py:4224
msgid ""
"Off by default: a file that changed since the run was edited afterwards, and"
" that edit is not this run's to undo."
msgstr ""
"Desativado por padrão: um arquivo que mudou desde a execução foi editado "
"depois, e essa edição não cabe a esta execução desfazer."

#: src/photo_tagger/gui.py:4231
msgid "What happened to each file appears here."
msgstr "O que aconteceu com cada arquivo aparece aqui."

#: src/photo_tagger/gui.py:4234
msgid "Preview"
msgstr "Prévia"

#: src/photo_tagger/gui.py:4236
msgid "Report what undoing would put back, without touching anything."
msgstr "Informa o que desfazer restauraria, sem tocar em nada."

#: src/photo_tagger/gui.py:4239
msgid "Undo"
msgstr "Desfazer"

#: src/photo_tagger/gui.py:4273
msgid "No recorded runs to undo."
msgstr "Nenhuma execução registrada para desfazer."

#: src/photo_tagger/gui.py:4280
msgid "Pick a run first."
msgstr "Escolha uma execução primeiro."

#: src/photo_tagger/gui.py:4285
msgid "Could not read that run"
msgstr "Não foi possível ler essa execução"

#: src/photo_tagger/gui.py:4288 src/photo_tagger/gui_state.py:849
msgid "That run recorded no writes."
msgstr "Essa execução não registrou nenhuma gravação."

#: src/photo_tagger/gui.py:4300
#, python-brace-format
msgid "Preview: {summary}"
msgstr "Prévia: {summary}"

#: src/photo_tagger/gui.py:4310
msgid "Undo this run?"
msgstr "Desfazer esta execução?"

#: src/photo_tagger/gui.py:4312
#, python-brace-format
msgid ""
"Put back {n} file? Sidecars the run created are deleted, and files it "
"overwrote are restored from their backup."
msgid_plural ""
"Put back {n} files? Sidecars the run created are deleted, and files it "
"overwrote are restored from their backup."
msgstr[0] ""
"Restaurar {n} arquivo? Os sidecars que a execução criou são apagados, e os "
"arquivos que ela sobrescreveu são restaurados do backup."
msgstr[1] ""
"Restaurar {n} arquivos? Os sidecars que a execução criou são apagados, e os "
"arquivos que ela sobrescreveu são restaurados do backup."

#: src/photo_tagger/gui.py:4356
msgid "Watch a folder"
msgstr "Monitorar uma pasta"

#: src/photo_tagger/gui.py:4361
msgid ""
"Point this at the folder your card reader, tethered capture, or sync client "
"fills. Photos already there are picked up first, then each new one as it "
"lands."
msgstr ""
"Aponte para a pasta que seu leitor de cartão, captura conectada ou cliente "
"de sincronização preenche. As fotos que já estão lá são pegas primeiro, e "
"depois cada nova conforme chega."

#: src/photo_tagger/gui.py:4369
msgid "Generate each new photo"
msgstr "Gerar cada foto nova"

#: src/photo_tagger/gui.py:4372
msgid "Save it too, without reviewing"
msgstr "Salvar também, sem revisar"

#: src/photo_tagger/gui.py:4375
msgid ""
"Off by default: the window is built around reviewing before writing. Turn it"
" on for an unattended import, where it behaves like the CLI's watch command."
msgstr ""
"Desativado por padrão: a janela foi feita para revisar antes de gravar. "
"Ative para uma importação sem supervisão, em que ela se comporta como o "
"comando watch da linha de comando."

#: src/photo_tagger/gui.py:4381
msgid "Start Watching"
msgstr "Começar a Monitorar"

#: src/photo_tagger/gui.py:4398
msgid "(pick a folder)"
msgstr "(escolha uma pasta)"

#: src/photo_tagger/gui.py:4404
msgid "Folder"
msgstr "Pasta"

#: src/photo_tagger/gui.py:4414 src/photo_tagger/gui.py:4427
msgid " seconds"
msgstr " segundos"

#: src/photo_tagger/gui.py:4417
msgid ""
"How often the folder is listed. Polling behaves the same on every platform "
"and over network shares."
msgstr ""
"Com que frequência a pasta é listada. A varredura se comporta igual em "
"qualquer plataforma e em compartilhamentos de rede."

#: src/photo_tagger/gui.py:4421
msgid "Check every"
msgstr "Verificar a cada"

#: src/photo_tagger/gui.py:4430
msgid ""
"How long a file must sit unchanged before it is picked up, so a photo still "
"being copied is left alone until the copy finishes."
msgstr ""
"Quanto tempo um arquivo precisa ficar sem mudar antes de ser pego, para que "
"uma foto ainda sendo copiada fique intocada até a cópia terminar."

#: src/photo_tagger/gui.py:4434
msgid "Settle for"
msgstr "Estabilizar por"

#: src/photo_tagger/gui.py:4441
msgid "Choose a folder to watch"
msgstr "Escolha uma pasta para monitorar"

