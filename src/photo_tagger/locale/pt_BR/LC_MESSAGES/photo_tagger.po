msgid_plural "{n} photos in {folder}."
msgstr[0] "{n} foto em {folder}."
msgstr[1] "{n} fotos em {folder}."

#: src/photo_tagger/gui.py:2984
#, python-brace-format
msgid "Showing {shown} of {total} in {folder}."
msgstr "Mostrando {shown} de {total} em {folder}."

#: src/photo_tagger/gui.py:3070
#, python-brace-format
msgid "(from {sources})"
msgstr "(de {sources})"

#: src/photo_tagger/gui.py:3070
