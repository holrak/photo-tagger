#: src/photo_tagger/gui.py:214
msgid "(none)"
msgstr "(nenhum)"

#: src/photo_tagger/gui.py:220
msgid ""
"Add photos to get started.\n"
"\n"
"Drag photos or folders onto the window, or use the Add Photos button."
msgstr ""
"Adicione fotos para começar.\n"
"\n"
"Arraste fotos ou pastas para a janela, ou use o botão Adicionar Fotos."

#: src/photo_tagger/gui.py:224
msgid ""
"Select a photo to review it.\n"
"\n"
"Generate proposes a title, description, and keywords you can edit before saving."
msgstr ""
"Selecione uma foto para revisá-la.\n"
"\n"
"Gerar propõe um título, uma descrição e palavras-chave que você pode editar antes de salvar."

