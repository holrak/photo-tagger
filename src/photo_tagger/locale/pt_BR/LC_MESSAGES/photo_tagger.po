#: src/photo_tagger/gui.py:985
#, python-brace-format
msgid "Organizing {n} keyword(s) with {model}..."
msgstr "Organizando {n} palavra(s)-chave com {model}..."

#: src/photo_tagger/gui.py:1252
msgid "File"
msgstr "Arquivo"

#: src/photo_tagger/gui.py:1253 src/photo_tagger/gui.py:1752
msgid "Add Photos..."
msgstr "Adicionar Fotos..."

#: src/photo_tagger/gui.py:1254 src/photo_tagger/gui.py:1782
msgid "Add Folder..."
msgstr "Adicionar Pasta..."

#: src/photo_tagger/gui.py:1256
msgid "Export CSV Report..."
msgstr "Exportar Relatório CSV..."

#: src/photo_tagger/gui.py:1259
msgid ""
"Save a CSV report of every photo: generated and existing metadata, EXIF, "
"and token usage."
msgstr ""
"Salva um relatório CSV de todas as fotos: metadados gerados e existentes,"
" EXIF e uso de tokens."

#: src/photo_tagger/gui.py:1264
msgid "Clear List"
msgstr "Limpar Lista"

#: src/photo_tagger/gui.py:1266
msgid "Quit"
msgstr "Sair"

#: src/photo_tagger/gui.py:1273
msgid "Help"
msgstr "Ajuda"

#: src/photo_tagger/gui.py:1275
msgid "Documentation"
msgstr "Documentação"

#: src/photo_tagger/gui.py:1279 src/photo_tagger/gui.py:1683
msgid "Test Connection"
msgstr "Testar Conexão"

#: src/photo_tagger/gui.py:1280
msgid "Open Logs"
msgstr "Abrir Logs"

#: src/photo_tagger/gui.py:1282 src/photo_tagger/gui.py:1600
msgid "About Photo Tagger"
msgstr "Sobre o Photo Tagger"

#: src/photo_tagger/gui.py:1287
msgid "Settings"
msgstr "Configurações"

#: src/photo_tagger/gui.py:1289
msgid "Cache AI Results"
msgstr "Armazenar Resultados de IA em Cache"

#: src/photo_tagger/gui.py:1294
#, python-brace-format
msgid ""
"Reuse earlier results for unchanged photos ({cache_file}). Uncheck to "
"call the model again for everything; a single photo can skip the cache "
"from its right-click menu."
msgstr ""
"Reutiliza resultados anteriores para fotos inalteradas ({cache_file}). "
"Desmarque para chamar o modelo novamente para tudo; uma única foto pode "
"ignorar o cache pelo menu de clique direito."

#: src/photo_tagger/gui.py:1301
msgid "Send Anonymous Telemetry"
msgstr "Enviar Telemetria Anônima"

#: src/photo_tagger/gui.py:1306
msgid ""
"Anonymous usage stats (model, batch size, OS, CPU/GPU model, RAM, timing)"
" and crash reports (error type and code location only). No photos, error "
"messages, or personal data."
msgstr ""
"Estatísticas de uso anônimas (modelo, tamanho do lote, SO, modelo de "
"CPU/GPU, RAM, tempos) e relatórios de falha (apenas tipo de erro e local "
"no código). Nenhuma foto, mensagem de erro ou dado pessoal."

#: src/photo_tagger/gui.py:1313
msgid "Record Saves for Undo"
msgstr "Registrar Gravações para Desfazer"

#: src/photo_tagger/gui.py:1318
msgid ""
"Record every file a save writes, so Tools > Undo Writes can put it back. "
"On by default: the saves worth undoing are the ones nobody planned to."
msgstr ""
"Registra cada arquivo que uma gravação escreve, para que Ferramentas > "
"Desfazer Gravações possa restaurá-lo. Ativado por padrão: as gravações "
"que vale a pena desfazer são as que ninguém planejou."

#: src/photo_tagger/gui.py:1325
msgid "Keyword Rules..."
msgstr "Regras de Palavras-chave..."

#: src/photo_tagger/gui.py:1330
msgid ""
"The controlled vocabulary generated keywords are snapped onto, and "
"whether the keywords of one shoot are made to agree with each other."
msgstr ""
"O vocabulário controlado ao qual as palavras-chave geradas são ajustadas,"
" e se as palavras-chave de uma mesma sessão são harmonizadas entre si."

#: src/photo_tagger/gui.py:1339
msgid "Save Settings as Defaults..."
msgstr "Salvar Configurações como Padrão..."

#: src/photo_tagger/gui.py:1344
msgid ""
"Update the config file with the current provider, model, URL, file types,"
" and save options. Other settings and comments in the file are preserved;"
" the API key is never written."
msgstr ""
"Atualiza o arquivo de configuração com o provedor, modelo, URL, tipos de "
"arquivo e opções de gravação atuais. As demais configurações e "
"comentários do arquivo são preservados; a chave de API nunca é gravada."

#: src/photo_tagger/gui.py:1349
msgid "Edit Config File..."
msgstr "Editar Arquivo de Configuração..."

#: src/photo_tagger/gui.py:1352
msgid ""
"Open the config file in your default editor for the settings the GUI does"
" not surface (prompt file, sampling, workers, filters, ...). Created if "
"missing."
msgstr ""
"Abre o arquivo de configuração no seu editor padrão para as opções que a "
"interface não expõe (arquivo de prompt, amostragem, workers, filtros, "
"...). Criado se não existir."

#: src/photo_tagger/gui.py:1359
msgid "Tools"
msgstr "Ferramentas"

#: src/photo_tagger/gui.py:1362
msgid "Build Vocabulary..."
msgstr "Construir Vocabulário..."

#: src/photo_tagger/gui.py:1365
msgid ""
"Write a keyword file out of the keywords your photos already carry, which"
" is what the strict vocabulary needs to enforce."
msgstr ""
"Gera um arquivo de palavras-chave a partir das que suas fotos já têm, que"
" é o que o vocabulário estrito precisa para ser aplicado."

#: src/photo_tagger/gui.py:1369
msgid "Harmonize Shoots Now"
msgstr "Harmonizar Sessões Agora"

#: src/photo_tagger/gui.py:1372
msgid ""
"Make the keywords of each shoot agree with each other: the spelling and "
"the hierarchy most of the shoot used win for all of it. Runs "
"automatically after every generation once a session gap is set (Settings "
"> Keyword Rules)."
msgstr ""
"Faz as palavras-chave de cada sessão concordarem entre si: a grafia e a "
"hierarquia usadas na maior parte da sessão valem para toda ela. Roda "
"automaticamente depois de cada geração quando há um intervalo de sessão "
"definido (Configurações > Regras de Palavras-chave)."

#: src/photo_tagger/gui.py:1378 src/photo_tagger/gui.py:4561
msgid "Watch Folder..."
msgstr "Monitorar Pasta..."

#: src/photo_tagger/gui.py:1381
msgid ""
"Tag photos as they arrive: point it at the folder your card reader or "
"sync client fills, and each new photo joins the list and is generated for"
" review."
msgstr ""
"Etiqueta as fotos conforme elas chegam: aponte para a pasta que seu "
"leitor de cartão ou cliente de sincronização preenche, e cada foto nova "
"entra na lista e é gerada para revisão."

#: src/photo_tagger/gui.py:1386
msgid "Undo Writes..."
msgstr "Desfazer Gravações..."

#: src/photo_tagger/gui.py:1389
msgid ""
"Put back what a recorded run wrote: sidecars it created are deleted, "
"files it overwrote are restored from the ExifTool backup. Covers CLI runs"
" too."
msgstr ""
"Restaura o que uma execução registrada gravou: os sidecars que ela criou "
"são apagados e os arquivos que ela sobrescreveu são restaurados do backup"
" do ExifTool. Vale também para execuções na linha de comando."

#: src/photo_tagger/gui.py:1396
msgid "Language"
msgstr "Idioma"

#: src/photo_tagger/gui.py:1399
msgid ""
"Language of the app itself (menus, buttons, messages). The language of "
"the generated metadata is set under Metadata Language."
msgstr ""
"Idioma do próprio aplicativo (menus, botões, mensagens). O idioma dos "
"metadados gerados é definido em Idioma dos Metadados."

#: src/photo_tagger/gui.py:1404
msgid "System Default"
msgstr "Padrão do Sistema"

#: src/photo_tagger/gui.py:1428
msgid "Language saved. Restart Photo Tagger to apply it."
msgstr "Idioma salvo. Reinicie o Photo Tagger para aplicá-lo."

#: src/photo_tagger/gui.py:1432 src/photo_tagger/gui.py:1490
msgid "Metadata Language"
msgstr "Idioma dos Metadados"

#: src/photo_tagger/gui.py:1436
msgid ""
"Language of the generated titles, descriptions, and keywords. The "
"language of the app itself is set under Language."
msgstr ""
"Idioma dos títulos, descrições e palavras-chave gerados. O idioma do "
"próprio aplicativo é definido em Idioma."

#: src/photo_tagger/gui.py:1445
msgid "Other..."
msgstr "Outro..."

#: src/photo_tagger/gui.py:1448
msgid ""
"Any language name the model understands works; it is sent to the model as"
" is. Saved to the config file, which the CLI's --output-language default "
"also reads."
msgstr ""
"Qualquer nome de idioma que o modelo entenda funciona; ele é enviado ao "
"modelo como está. Salvo no arquivo de configuração, de onde a CLI também "
"lê o padrão de --output-language."

#: src/photo_tagger/gui.py:1491
msgid "Language for the generated titles, descriptions, and keywords:"
msgstr "Idioma dos títulos, descrições e palavras-chave gerados:"

#: src/photo_tagger/gui.py:1523
#, python-brace-format
msgid "Metadata language set to {language} for the next generation."
msgstr "Idioma dos metadados definido como {language} para a próxima geração."

#: src/photo_tagger/gui.py:1533
msgid "Anonymous telemetry on."
msgstr "Telemetria anônima ativada."

#: src/photo_tagger/gui.py:1533
msgid "Anonymous telemetry off."
msgstr "Telemetria anônima desativada."

#: src/photo_tagger/gui.py:1577
#, python-brace-format
msgid "Updated {target} (other settings and comments preserved)."
msgstr "{target} atualizado (demais configurações e comentários preservados)."

#: src/photo_tagger/gui.py:1580
#, python-brace-format
msgid "Saved defaults to {target}."
msgstr "Padrões salvos em {target}."

#: src/photo_tagger/gui.py:1602
msgid "Describe photos and add keywords with a vision-language model."
msgstr ""
"Descreva fotos e adicione palavras-chave com um modelo de visão e "
"linguagem."

#: src/photo_tagger/gui.py:1618
msgid "Backend that serves the vision-language model."
msgstr "Backend que serve o modelo de visão e linguagem."

#: src/photo_tagger/gui.py:1626
msgid ""
"Model identifier. Type it, or press Refresh to list what the provider "
"serves."
msgstr ""
"Identificador do modelo. Digite-o ou pressione Atualizar para listar o "
"que o provedor serve."

#: src/photo_tagger/gui.py:1629
msgid "Refresh"
msgstr "Atualizar"

#: src/photo_tagger/gui.py:1630
msgid "Query the provider for the models it currently serves."
msgstr "Consulta ao provedor os modelos servidos no momento."

#: src/photo_tagger/gui.py:1634
msgid "Connection..."
msgstr "Conexão..."

#: src/photo_tagger/gui.py:1635
msgid "Server URL, API key, and a connection test."
msgstr "URL do servidor, chave de API e um teste de conexão."

#: src/photo_tagger/gui.py:1639
msgid "Provider"
msgstr "Provedor"

#: src/photo_tagger/gui.py:1641
msgid "Model"
msgstr "Modelo"

#: src/photo_tagger/gui.py:1651
msgid "Connection settings"
msgstr "Configurações de conexão"

#: src/photo_tagger/gui.py:1659
msgid "(provider default URL)"
msgstr "(URL padrão do provedor)"

#: src/photo_tagger/gui.py:1661
msgid "Provider API base URL. Leave blank to use the provider's default."
msgstr ""
"URL base da API do provedor. Deixe em branco para usar o padrão do "
"provedor."

#: src/photo_tagger/gui.py:1663
msgid "Base URL"
msgstr "URL base"

#: src/photo_tagger/gui.py:1672
msgid "(uses provider env var)"
msgstr "(usa a variável de ambiente do provedor)"

#: src/photo_tagger/gui.py:1675
msgid ""
"API key for the provider. Leave blank to use the provider's environment "
"variable (OPENAI_API_KEY, LM_STUDIO_API_KEY, LLAMA_CPP_API_KEY, or "
"OLLAMA_API_KEY). Required for OpenAI. A typed key is used for this "
"session only and is never written to disk."
msgstr ""
"Chave de API do provedor. Deixe em branco para usar a variável de "
"ambiente do provedor (OPENAI_API_KEY, LM_STUDIO_API_KEY, "
"LLAMA_CPP_API_KEY ou OLLAMA_API_KEY). Obrigatória para a OpenAI. Uma "
"chave digitada vale só para esta sessão e nunca é gravada em disco."

#: src/photo_tagger/gui.py:1681
msgid "API key"
msgstr "Chave de API"

#: src/photo_tagger/gui.py:1685
msgid "Check ExifTool and that the provider serves the model."
msgstr "Verifica o ExifTool e se o provedor serve o modelo."

#: src/photo_tagger/gui.py:1704
msgid "Photos"
msgstr "Fotos"

#: src/photo_tagger/gui.py:1704 src/photo_tagger/gui.py:2192
msgid "Type"
msgstr "Tipo"

#: src/photo_tagger/gui.py:1704 src/photo_tagger/gui.py:2193
msgid "Status"
msgstr "Status"

#: src/photo_tagger/gui.py:1704 src/photo_tagger/gui.py:2194
msgid "Tagged"
msgstr "Etiquetada"

#: src/photo_tagger/gui.py:1723
#, python-brace-format
msgid ""
"Click a column header to sort. Type: file extension, +xmp when a sidecar "
"exists.\n"
"Tagged: metadata already on the file ({legend})."
msgstr ""
"Clique no cabeçalho de uma coluna para ordenar. Tipo: extensão do "
"arquivo, +xmp quando existe um sidecar.\n"
"Etiquetada: metadados já presentes no arquivo ({legend})."

#: src/photo_tagger/gui.py:1738
msgid "Drag photos or folders here. Select one and press Delete to remove it."
msgstr ""
"Arraste fotos ou pastas para cá. Selecione uma e pressione Delete para "
"removê-la."

#: src/photo_tagger/gui.py:1755
msgid ""
"Add photos (click), or open the arrow for adding a whole folder and for "
"the folder-scan options. Dragging files or folders onto the window also "
"works."
msgstr ""
"Adicione fotos (clique) ou abra a seta para adicionar uma pasta inteira e"
" para as opções de varredura de pastas. Arrastar arquivos ou pastas para "
"a janela também funciona."

#: src/photo_tagger/gui.py:1765
msgid "Select"
msgstr "Selecionar"

#: src/photo_tagger/gui.py:1767
msgid "Check or uncheck photos in bulk."
msgstr "Marque ou desmarque fotos em lote."

#: src/photo_tagger/gui.py:1771
msgid "Remove"
msgstr "Remover"

#: src/photo_tagger/gui.py:1773
msgid "Remove the selected folder or photo from the list (or press Delete)."
msgstr "Remove a pasta ou foto selecionada da lista (ou pressione Delete)."

#: src/photo_tagger/gui.py:1790
msgid ""
"Extensions to scan for in folders (comma-separated).\n"
"Case-insensitive: jpg matches .JPG. Note jpeg is separate from jpg."
msgstr ""
"Extensões a procurar nas pastas (separadas por vírgula).\n"
"Sem distinção de maiúsculas: jpg encontra .JPG. Note que jpeg é separado "
"de jpg."

#: src/photo_tagger/gui.py:1794
msgid "File types"
msgstr "Tipos de arquivo"

#: src/photo_tagger/gui.py:1795 src/photo_tagger/gui.py:4411
msgid "Include subfolders"
msgstr "Incluir subpastas"

#: src/photo_tagger/gui.py:1797
msgid "Descend into subfolders when adding a folder."
msgstr "Desce às subpastas ao adicionar uma pasta."

#: src/photo_tagger/gui.py:1807
msgid "Check All"
msgstr "Marcar Todas"

#: src/photo_tagger/gui.py:1808
msgid "Uncheck All"
msgstr "Desmarcar Todas"

#: src/photo_tagger/gui.py:1809
msgid "Invert Checked"
msgstr "Inverter Marcação"

#: src/photo_tagger/gui.py:1812
msgid "Uncheck Already Tagged"
msgstr "Desmarcar Já Etiquetadas"

#: src/photo_tagger/gui.py:1815
msgid ""
"Uncheck photos that already have the chosen metadata (in the image or its"
" XMP sidecar), e.g. 'a title and a description' to skip those while "
"keeping keyword-only photos. Mirrors the CLI's --skip-tagged."
msgstr ""
"Desmarca fotos que já têm os metadados escolhidos (na imagem ou no "
"sidecar XMP), p. ex. 'título e descrição' para pular essas mantendo as "
"fotos só com palavras-chave. Espelha o --skip-tagged da CLI."

#: src/photo_tagger/gui.py:1832
msgid "Uncheck From Skip List..."
msgstr "Desmarcar por Lista de Exclusão..."

#: src/photo_tagger/gui.py:1835
msgid ""
"Uncheck photos whose filename or full path is listed in a text file (one "
"per line), like the CLI's --skip-from."
msgstr ""
"Desmarca fotos cujo nome ou caminho completo esteja listado em um arquivo"
" de texto (um por linha), como o --skip-from da CLI."

#: src/photo_tagger/gui.py:1844 src/photo_tagger/gui.py:1854
msgid "Add photos before selecting."
msgstr "Adicione fotos antes de selecionar."

#: src/photo_tagger/gui.py:1885
msgid "Retry Generation"
msgstr "Tentar Gerar Novamente"

#: src/photo_tagger/gui.py:1885
msgid "Generate"
msgstr "Gerar"

#: src/photo_tagger/gui.py:1889
msgid "Generate (Skip Cache)"
msgstr "Gerar (Ignorar Cache)"

#: src/photo_tagger/gui.py:1893
msgid "Call the model even when a cached result exists for this photo."
msgstr "Chama o modelo mesmo quando existe um resultado em cache para esta foto."

#: src/photo_tagger/gui.py:1899 src/photo_tagger/gui.py:1953
msgid "Remove From List"
msgstr "Remover da Lista"

#: src/photo_tagger/gui.py:1921
#, python-brace-format
msgid "Check {n} Photo"
msgid_plural "Check {n} Photos"
msgstr[0] "Marcar {n} Foto"
msgstr[1] "Marcar {n} Fotos"

#: src/photo_tagger/gui.py:1925
#, python-brace-format
msgid "Uncheck {n} Photo"
msgid_plural "Uncheck {n} Photos"
msgstr[0] "Desmarcar {n} Foto"
msgstr[1] "Desmarcar {n} Fotos"

#: src/photo_tagger/gui.py:1929
#, python-brace-format
msgid "Check Only {n} Photo"
msgid_plural "Check Only {n} Photos"
msgstr[0] "Marcar Apenas {n} Foto"
msgstr[1] "Marcar Apenas {n} Fotos"

#: src/photo_tagger/gui.py:1933
msgid "Check the selected photos and uncheck every other photo in the list."
msgstr "Marca as fotos selecionadas e desmarca todas as outras da lista."

#: src/photo_tagger/gui.py:1937
#, python-brace-format
msgid "Generate {n} Photo"
msgid_plural "Generate {n} Photos"
msgstr[0] "Gerar {n} Foto"
msgstr[1] "Gerar {n} Fotos"

#: src/photo_tagger/gui.py:1943
#, python-brace-format
msgid "Generate {n} Photo (Skip Cache)"
msgid_plural "Generate {n} Photos (Skip Cache)"
msgstr[0] "Gerar {n} Foto (Ignorar Cache)"
msgstr[1] "Gerar {n} Fotos (Ignorar Cache)"

#: src/photo_tagger/gui.py:1949 src/photo_tagger/gui.py:2601
msgid "One-time: call the model even for photos with cached results."
msgstr "Uma única vez: chama o modelo mesmo para fotos com resultados em cache."

#: src/photo_tagger/gui.py:2171
msgid "Show"
msgstr "Mostrar"

#: src/photo_tagger/gui.py:2174
msgid "All"
msgstr "Todas"

#: src/photo_tagger/gui.py:2175
msgid "Selected"
msgstr "Selecionadas"

#: src/photo_tagger/gui.py:2176
msgid "Not generated"
msgstr "Não geradas"

#: src/photo_tagger/gui.py:2177
msgid "Generated"
msgstr "Geradas"

#: src/photo_tagger/gui.py:2178
msgid "Saved"
msgstr "Salvas"

#: src/photo_tagger/gui.py:2179
msgid "Failed"
msgstr "Com falha"

#: src/photo_tagger/gui.py:2180
msgid "Untagged"
msgstr "Sem etiquetas"

#: src/photo_tagger/gui.py:2183
msgid "Show only the photos in the chosen state."
msgstr "Mostra apenas as fotos no estado escolhido."

#: src/photo_tagger/gui.py:2188
msgid "Sort by"
msgstr "Ordenar por"

#: src/photo_tagger/gui.py:2191
msgid "Name"
msgstr "Nome"

#: src/photo_tagger/gui.py:2198
msgid "Order the thumbnails by name, file type, status, or existing metadata."
msgstr ""
"Ordena as miniaturas por nome, tipo de arquivo, status ou metadados "
"existentes."

#: src/photo_tagger/gui.py:2207 src/photo_tagger/gui.py:2233
msgid "Ascending. Click to sort descending."
msgstr "Crescente. Clique para ordenar de forma decrescente."

#: src/photo_tagger/gui.py:2231
msgid "Descending. Click to sort ascending."
msgstr "Decrescente. Clique para ordenar de forma crescente."

#: src/photo_tagger/gui.py:2253
msgid "Select a photo to preview it."
msgstr "Selecione uma foto para visualizá-la."

#: src/photo_tagger/gui.py:2280
msgid "Existing"
msgstr "Existente"

#: src/photo_tagger/gui.py:2285
msgid ""
"Where the existing metadata was read from: the image file, an XMP "
"sidecar, or both."
msgstr ""
"De onde os metadados existentes foram lidos: do arquivo de imagem, de um "
"sidecar XMP ou de ambos."

#: src/photo_tagger/gui.py:2292
msgid "New (editable)"
msgstr "Novo (editável)"

#: src/photo_tagger/gui.py:2297
msgid "The title to write. Edit freely before saving."
msgstr "O título a gravar. Edite à vontade antes de salvar."

#: src/photo_tagger/gui.py:2298
msgid "Title"
msgstr "Título"

#: src/photo_tagger/gui.py:2305
msgid "The description to write."
msgstr "A descrição a gravar."

#: src/photo_tagger/gui.py:2310
msgid "Description"
msgstr "Descrição"

#: src/photo_tagger/gui.py:2317
msgid "One per line. Use < for hierarchy (Duck<Bird<Animal)"
msgstr "Uma por linha. Use < para hierarquia (Pato<Ave<Animal)"

#: src/photo_tagger/gui.py:2320
msgid ""
"Keywords to write, one per line. Use '<' for a hierarchy (e.g. "
"'Duck<Bird<Animal'); the changes and resulting paths show below."
msgstr ""
"Palavras-chave a gravar, uma por linha. Use '<' para hierarquia (p. ex. "
"'Pato<Ave<Animal'); as mudanças e os caminhos resultantes aparecem "
"abaixo."

#: src/photo_tagger/gui.py:2325
msgid "Keywords"
msgstr "Palavras-chave"

#: src/photo_tagger/gui.py:2334
msgid "Keyword changes"
msgstr "Mudanças de palavras-chave"

#: src/photo_tagger/gui.py:2340
msgid ""
"Show exactly what saving will change: added and removed keywords, plus "
"the resulting keyword tree."
msgstr ""
"Mostra exatamente o que salvar vai mudar: palavras-chave adicionadas e "
"removidas, mais a árvore de palavras-chave resultante."

#: src/photo_tagger/gui.py:2355
msgid "Keyword changes a save will make: green added, red removed."
msgstr ""
"Mudanças de palavras-chave que salvar fará: verde adicionada, vermelho "
"removida."

#: src/photo_tagger/gui.py:2361
msgid ""
"The keyword tree that saving will write (stored as Lightroom hierarchy "
"paths)."
msgstr ""
"A árvore de palavras-chave que salvar gravará (armazenada como caminhos "
"de hierarquia do Lightroom)."

#: src/photo_tagger/gui.py:2364
msgid "Changes"
msgstr "Mudanças"

#: src/photo_tagger/gui.py:2365
msgid "Tree"
msgstr "Árvore"

#: src/photo_tagger/gui.py:2380
msgid "Write Title"
msgstr "Gravar Título"

#: src/photo_tagger/gui.py:2382
msgid "Write the title. Uncheck to leave the existing title as is."
msgstr "Grava o título. Desmarque para manter o título existente como está."

#: src/photo_tagger/gui.py:2384
msgid "Write Description"
msgstr "Gravar Descrição"

#: src/photo_tagger/gui.py:2386
msgid "Write the description. Uncheck to leave the existing description as is."
msgstr "Grava a descrição. Desmarque para manter a descrição existente como está."

#: src/photo_tagger/gui.py:2388
msgid "Write Keywords"
msgstr "Gravar Palavras-chave"

#: src/photo_tagger/gui.py:2391
msgid ""
"Write keywords. Uncheck to leave existing keywords untouched, e.g. to "
"refresh only the title and description."
msgstr ""
"Grava as palavras-chave. Desmarque para não tocar nas palavras-chave "
"existentes, p. ex. para atualizar só o título e a descrição."

#: src/photo_tagger/gui.py:2411
msgid "Overwrite Existing Keywords"
msgstr "Sobrescrever Palavras-chave Existentes"

#: src/photo_tagger/gui.py:2413
msgid "Replace existing keywords instead of merging the new ones in."
msgstr "Substitui as palavras-chave existentes em vez de mesclar as novas."

#: src/photo_tagger/gui.py:2416
msgid "Embed in Photo"
msgstr "Embutir na Foto"

#: src/photo_tagger/gui.py:2417
msgid "Write into the image file instead of an XMP sidecar."
msgstr "Grava no arquivo de imagem em vez de em um sidecar XMP."

#: src/photo_tagger/gui.py:2418
msgid "Keep ExifTool Backup"
msgstr "Manter Backup do ExifTool"

#: src/photo_tagger/gui.py:2421
msgid ""
"Let ExifTool save the untouched file as *_original before writing. "
"Uncheck to write in place, which leaves no extra copies filling up the "
"disk on a large batch (make sure you have a backup elsewhere)."
msgstr ""
"Deixa o ExifTool salvar o arquivo original como *_original antes de "
"gravar. Desmarque para gravar no lugar, sem deixar cópias extras ocupando"
" o disco em um lote grande (garanta que você tenha um backup em outro "
"lugar)."

#: src/photo_tagger/gui.py:2454 src/photo_tagger/gui_state.py:1045
msgid "title"
msgstr "título"

#: src/photo_tagger/gui.py:2455 src/photo_tagger/gui_state.py:1046
msgid "description"
msgstr "descrição"

#: src/photo_tagger/gui.py:2460
msgid "nothing (pick a field in the arrow menu)"
msgstr "nada (escolha um campo no menu da seta)"

#: src/photo_tagger/gui.py:2463
msgid "overwriting existing keywords"
msgstr "sobrescrevendo as palavras-chave existentes"

#: src/photo_tagger/gui.py:2465
msgid "merging with existing keywords"
msgstr "mesclando com as palavras-chave existentes"

#: src/photo_tagger/gui.py:2468
msgid "into the image file"
msgstr "no arquivo de imagem"

#: src/photo_tagger/gui.py:2468
msgid "to an XMP sidecar"
msgstr "em um sidecar XMP"

#: src/photo_tagger/gui.py:2471
msgid "keeping a *_original backup"
msgstr "mantendo um backup *_original"

#: src/photo_tagger/gui.py:2473
msgid "with no *_original backup"
msgstr "sem backup *_original"

#: src/photo_tagger/gui.py:2479
#, python-brace-format
msgid "Currently writes {options}."
msgstr "Atualmente grava {options}."

#: src/photo_tagger/gui.py:2482
#, python-brace-format
msgid "Write this photo. {summary} Change what is written with the arrow."
msgstr "Grava esta foto. {summary} Mude o que é gravado pela seta."

#: src/photo_tagger/gui.py:2488
#, python-brace-format
msgid ""
"Write the checked photos that have a generated proposal. {summary} Change"
" what is written with the arrow."
msgstr ""
"Grava as fotos marcadas que têm uma proposta gerada. {summary} Mude o que"
" é gravado pela seta."

#: src/photo_tagger/gui.py:2497
msgid "Hint for the AI"
msgstr "Dica para a IA"

#: src/photo_tagger/gui.py:2499
msgid "e.g. 'The animal is a deer, not a boar'"
msgstr "ex.: 'O animal é um veado, não um javali'"

#: src/photo_tagger/gui.py:2503
msgid ""
"A note about this photo that the model trusts over its own reading of the"
" image; useful when it misidentifies the subject. It is sent along on "
"every generation of this photo (a hinted photo skips the cached result) "
"and is never written to the file. Press Enter to regenerate right away."
msgstr ""
"Uma nota sobre esta foto na qual o modelo confia mais do que na própria "
"leitura da imagem; útil quando ele identifica o assunto errado. É enviada"
" em toda geração desta foto (uma foto com dica ignora o resultado em "
"cache) e nunca é gravada no arquivo. Pressione Enter para gerar "
"novamente."

#: src/photo_tagger/gui.py:2516
msgid "Generate This Photo"
msgstr "Gerar Esta Foto"

#: src/photo_tagger/gui.py:2518
msgid "Run the model on just this photo, regardless of which photos are checked."
msgstr ""
"Executa o modelo só nesta foto, independentemente de quais fotos estão "
"marcadas."

#: src/photo_tagger/gui.py:2527
msgid "Generate This Photo (Skip Cache)"
msgstr "Gerar Esta Foto (Ignorar Cache)"

#: src/photo_tagger/gui.py:2530
msgid "One-time: call the model even when a cached result exists."
msgstr "Uma única vez: chama o modelo mesmo quando existe um resultado em cache."

#: src/photo_tagger/gui.py:2536
msgid "Save This Photo"
msgstr "Salvar Esta Foto"

#: src/photo_tagger/gui.py:2548 src/photo_tagger/gui.py:2717
msgid "Drag photos or folders here to begin."
msgstr "Arraste fotos ou pastas para cá para começar."

#: src/photo_tagger/gui.py:2564
msgid "Retry Failed"
msgstr "Repetir Falhas"

#: src/photo_tagger/gui.py:2567
msgid ""
"Re-run the model on every photo that failed to generate. Enabled once a "
"photo has actually failed."
msgstr ""
"Executa o modelo novamente em cada foto que falhou ao gerar. Habilitado "
"quando alguma foto realmente falhou."

#: src/photo_tagger/gui.py:2573 src/photo_tagger/gui.py:4389
msgid "Cancel"
msgstr "Cancelar"

#: src/photo_tagger/gui.py:2576
msgid ""
"Stop the run in progress, generating or saving. The photo currently in "
"flight finishes; the rest are left untouched so you can resume them "
"later."
msgstr ""
"Para a execução em andamento, geração ou gravação. A foto em andamento "
"termina; as demais ficam intocadas para você retomá-las depois."

#: src/photo_tagger/gui.py:2587
msgid "Generate Selected"
msgstr "Gerar Selecionadas"

#: src/photo_tagger/gui.py:2588
msgid "Run the model on the checked photos."
msgstr "Executa o modelo nas fotos marcadas."

#: src/photo_tagger/gui.py:2597
msgid "Generate Selected (Skip Cache)"
msgstr "Gerar Selecionadas (Ignorar Cache)"

#: src/photo_tagger/gui.py:2607
msgid "Save Selected"
msgstr "Salvar Selecionadas"

#: src/photo_tagger/gui.py:2641
msgid "Add Photos"
msgstr "Adicionar Fotos"

#: src/photo_tagger/gui.py:2646
msgid "Add a folder of photos"
msgstr "Adicionar uma pasta de fotos"

#: src/photo_tagger/gui.py:2730 src/photo_tagger/gui.py:2757
